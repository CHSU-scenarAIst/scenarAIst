# GigaChat API credentials (required)
# Obtain from https://developers.sber.ru/studio/workspaces/
GIGACHAT_CREDENTIALS=

# GigaChat model to use (optional, default: GigaChat-2)
GIGACHAT_MODEL=GigaChat-2

# Whether to verify SSL certificates (optional, default: true)
# Set to "false" if you haven't valid certificates
GIGACHAT_VERIFY_SSL_CERTS=false
