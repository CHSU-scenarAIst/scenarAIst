# =============================================================================
# GigaChat API
# =============================================================================

# Obtain from https://developers.sber.ru/studio/workspaces/
GIGACHAT_CREDENTIALS=your-credentials-here
# GigaChat model to use (optional, default: GigaChat-2)
GIGACHAT_MODEL=GigaChat-2
# Whether to verify SSL certificates (optional, default: true)
# Set to "false" if you haven't valid certificates
GIGACHAT_VERIFY_SSL_CERTS=false
# GigaChat embedding model (optional, default: Embeddings)
GIGACHAT_EMBEDDING_MODEL=Embeddings


# =============================================================================
# OpenRouter API
# =============================================================================

# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-api-key-here
# OpenRouter model (optional, default: openrouter/free)
OPENROUTER_MODEL=openrouter/free


# =============================================================================
# OpenAI API
# =============================================================================

# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here
# OpenAI base URL
OPENAI_BASE_URL=https://api.ofox.ai/v1
# OpenAI model
OPENAI_MODEL=z-ai/glm-4.7-flash:free
# OpenAI base URL
OPENAI_EMBEDDING_BASE_URL=https://api.ofox.ai/v1
# OpenAI embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# =============================================================================
# HuggingFace
# =============================================================================

# HuggingFace embedding model (optional, default: sentence-transformers/all-mpnet-base-v2)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2


# =============================================================================
# Tavily Search API
# =============================================================================

# Obtain from https://app.tavily.com/
TAVILY_API_KEY=your-api-key-here

"Погода в Москве из документов"
