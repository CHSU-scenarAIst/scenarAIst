# GigaChat API
# =============================================================================

# Obtain from https://developers.sber.ru/studio/workspaces/
GIGACHAT_CREDENTIALS=your-credentials-here
# GigaChat model to use (optional, default: GigaChat-2)
GIGACHAT_MODEL=GigaChat-2
# Whether to verify SSL certificates (optional, default: false)
# Set to "true" if you have valid certificates
GIGACHAT_VERIFY_SSL_CERTS=false


# OpenAI API
# =============================================================================

# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here
# OpenAI base URL
OPENAI_BASE_URL=https://api.ofox.ai/v1
# OpenAI model
OPENAI_MODEL=z-ai/glm-4.7-flash:free
# OpenAI base URL
OPENAI_EMBEDDING_BASE_URL=https://api.ofox.ai/v1
# OpenAI embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# HuggingFace
# =============================================================================

# HuggingFace embedding model (optional, default: sentence-transformers/all-mpnet-base-v2)
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2


# Tavily Search API
# =============================================================================

# Obtain from https://app.tavily.com/
TAVILY_API_KEY=your-api-key-here
