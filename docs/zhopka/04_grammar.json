{
  "language": "ЖёПка",
  "version": "1.0.0",
  "paradigm": "функциональная",
  "file_extension": ".ж",
  "description": "Формальная грамматика языка ЖёПка в расширенной BNF-нотации. Грамматика описывает синтаксис верхнего уровня, правила вложенности через символ '3', лексическую структуру и AST-узлы.",
  "grammar_format": "EBNF (Extended Backus-Naur Form) в JSON-представлении",
  "lexical_rules": {
    "keywords": [
      "жёпка", "принадлежит",
      "печать", "если", "иначе", "иначе_если", "пока", "для", "в",
      "функция", "вернуть", "прервать", "продолжить", "пропуск",
      "истина", "ложь", "ничто", "я", "и", "или", "не", "это",
      "карта", "функция", "свёртка", "лямбда", "пусть", "ряд",
      "список", "кортеж", "словарь", "множество", "строка", "целое", "дробное", "логическое",
      "ячейка", "тип", "вариант", "сопоставить",
      "исключение", "попытка", "перехват", "наконец",
      "класс", "наследует", "импорт", "из",
      "открыть", "читать", "писать", "закрыть", "с_файлом",
      "асинхронно", "ждать", "задача",
      "эффект", "обработать_эффект"
    ],
    "operators": ["+", "-", "*", "/", "%", "**", "==", "!=", "<", ">", "<=", ">=", "=", ":=", "!"],
    "special_symbols": ["3", "#", "."],
    "literals": {
      "integer": "последовательность цифр [0-9]+, опционально с префиксом 0x (hex), 0o (oct), 0b (bin)",
      "float": "последовательность цифр с точкой [0-9]+.[0-9]+, опционально с экспонентой [eE][+-]?[0-9]+",
      "string": "двойные кавычки с экранированием \\n \\t \\\\ \\\" \\3",
      "boolean": "истина | ложь",
      "none": "ничто"
    },
    "identifier": "буквы кириллицы [а-яё] или латиницы [a-zA-Z], цифры и подчёркивания, не может начинаться с цифры",
    "comment": "символ # до конца строки, не влияет на уровни вложенности",
    "nesting_marker": "последовательность символов '3' в начале строки, количество равно уровню вложенности"
  },
  "nesting_rules": {
    "description": "Каждая строка исходного кода может начинаться с последовательности символов '3'. Количество этих символов определяет уровень вложенности выражения в данной строке.",
    "levels": {
      "0": "отсутствие '3' — верхний уровень (top-level)",
      "1": "строка начинается с '3 ' — первый уровень вложенности",
      "2": "строка начинается с '33 ' — второй уровень вложенности",
      "3": "строка начинается с '333 ' — третий уровень вложенности",
      "n": "строка начинается с '3' * n + ' ' — n-ный уровень вложенности"
    },
    "transition_rules": [
      "Переход с уровня N на уровень N+1 разрешён в любой момент (открытие нового блока).",
      "Переход с уровня N на уровень M, где M < N, разрешён в любой момент (закрытие блоков).",
      "Переход с уровня N на уровень N+K, где K > 1, ЗАПРЕЩЁН. Уровни должны увеличиваться пошагово.",
      "После последовательности '3' должен стоять ровно один пробел. Табуляция и несколько пробелов вызывают ошибку ОшибкаФорматирования.",
      "Пустые строки внутри блока сохраняют текущий уровень вложенности — нужно ставить соответствующее количество '3'.",
      "Полностью пустая строка (без '3') интерпретируется как конец всех открытых блоков."
    ],
    "block_headers": [
      "функция", "если", "иначе", "иначе_если", "пока", "для",
      "попытка", "перехват", "наконец", "класс", "пусть", "тип",
      "сопоставить", "лямбда", "эффект", "с_файлом"
    ]
  },
  "self_import_rule": {
    "syntax": "жёпка принадлежит <имя_файла>.ж",
    "description": "Обязательная первая непустая строка каждого файла. Без неё интерпретатор отказывается запускать программу.",
    "constraints": {
      "must_be_first": true,
      "must_match_filename": true,
      "extension": ".ж",
      "max_length": 64,
      "allowed_chars": "строчные кириллица [а-яё], латиница [a-z], цифры [0-9], подчёркивание [_]",
      "forbidden_chars": "заглавные буквы, дефис, точки внутри имени, спецсимволы"
    },
    "errors": {
      "ОшибкаСамоИмпорта_Отсутствует": "первая непустая строка не соответствует шаблону",
      "ОшибкаСамоИмпорта_Несовпадение": "указанное имя не совпадает с реальным именем файла",
      "ОшибкаСамоИмпорта_НедопустимоеИмя": "имя содержит запрещённые символы"
    }
  },
  "productions": [
    {
      "nonterminal": "<программа>",
      "rule": "<самоимпорт> { <определение_верхнего_уровня> } [ <главное_выражение> ]"
    },
    {
      "nonterminal": "<самоимпорт>",
      "rule": "'жёпка' 'принадлежит' <имя_файла> '.ж'"
    },
    {
      "nonterminal": "<имя_файла>",
      "rule": "<идентификатор>"
    },
    {
      "nonterminal": "<определение_верхнего_уровня>",
      "rule": "<объявление_функции> | <объявление_класса> | <объявление_типа> | <объявление_пусть> | <импорт> | <выражение>"
    },
    {
      "nonterminal": "<главное_выражение>",
      "rule": "<выражение>"
    },
    {
      "nonterminal": "<строка>",
      "rule": "[ <маркер_вложенности> ] <содержимое_строки>"
    },
    {
      "nonterminal": "<маркер_вложенности>",
      "rule": "'3' { '3' }",
      "note": "Количество '3' определяет уровень вложенности"
    },
    {
      "nonterminal": "<содержимое_строки>",
      "rule": "<выражение> | <комментарий> | пусто"
    },
    {
      "nonterminal": "<комментарий>",
      "rule": "'#' <произвольный_текст>"
    },
    {
      "nonterminal": "<выражение>",
      "rule": "<литерал> | <идентификатор> | <операторное_выражение> | <вызов_функции> | <объявление_функции> | <условное> | <цикл> | <возврат> | <печать> | <пусть_связывание> | <лямбда> | <блок_try> | <блок_класса> | <сопоставление>"
    },
    {
      "nonterminal": "<литерал>",
      "rule": "<целое> | <дробное> | <строка> | <истина> | <ложь> | <ничто> | <список> | <кортеж> | <словарь> | <множество>"
    },
    {
      "nonterminal": "<список>",
      "rule": "'список' { <выражение> }"
    },
    {
      "nonterminal": "<кортеж>",
      "rule": "'кортеж' { <выражение> }"
    },
    {
      "nonterminal": "<словарь>",
      "rule": "'словарь' { <ключ> <значение> }"
    },
    {
      "nonterminal": "<множество>",
      "rule": "'множество' { <выражение> }"
    },
    {
      "nonterminal": "<объявление_функции>",
      "rule": "'функция' <идентификатор> { <параметр> } <тело_функции>",
      "note": "Тело функции находится на уровне N+1, где N — уровень объявления"
    },
    {
      "nonterminal": "<параметр>",
      "rule": "<идентификатор> [ <аннотация_типа> ] [ '=' <значение_по_умолчанию> ]"
    },
    {
      "nonterminal": "<аннотация_типа>",
      "rule": "<идентификатор_типа>",
      "examples": ["целое", "дробное", "строка", "логическое", "список", "кортеж", "словарь", "множество"]
    },
    {
      "nonterminal": "<тело_функции>",
      "rule": "{ <строка_уровня_N+1> }",
      "note": "Одна или более строк с маркером вложенности уровня N+1"
    },
    {
      "nonterminal": "<вызов_функции>",
      "rule": "<идентификатор> { <аргумент> } | <выражение> { <аргумент> }"
    },
    {
      "nonterminal": "<аргумент>",
      "rule": "<выражение> | <именованный_аргумент>",
      "note": "Поддерживается частичное применение (каррирование)"
    },
    {
      "nonterminal": "<именованный_аргумент>",
      "rule": "<идентификатор> '=' <выражение>"
    },
    {
      "nonterminal": "<условное>",
      "rule": "'если' <условие> <тело> [ 'иначе_если' <условие> <тело> ]* [ 'иначе' <тело> ]"
    },
    {
      "nonterminal": "<условие>",
      "rule": "<выражение>"
    },
    {
      "nonterminal": "<цикл>",
      "rule": "<цикл_пока> | <цикл_для>"
    },
    {
      "nonterminal": "<цикл_пока>",
      "rule": "'пока' <условие> <тело>"
    },
    {
      "nonterminal": "<цикл_для>",
      "rule": "'для' <идентификатор> 'в' <итератор> <тело>"
    },
    {
      "nonterminal": "<итератор>",
      "rule": "<выражение>",
      "note": "Любая последовательность: список, кортеж, множество, ряд, диапазон"
    },
    {
      "nonterminal": "<тело>",
      "rule": "{ <строка_следующего_уровня> }"
    },
    {
      "nonterminal": "<возврат>",
      "rule": "'вернуть' <выражение>"
    },
    {
      "nonterminal": "<печать>",
      "rule": "'печать' <выражение>"
    },
    {
      "nonterminal": "<пусть_связывание>",
      "rule": "'пусть' <идентификатор> [ <аннотация_типа> ] '=' <выражение>",
      "note": "Создаёт неизменяемую связь"
    },
    {
      "nonterminal": "<лямбда>",
      "rule": "'лямбда' { <параметр> } <выражение>",
      "note": "Анонимная функция"
    },
    {
      "nonterminal": "<операторное_выражение>",
      "rule": "<выражение> <оператор> <выражение> | <унарный_оператор> <выражение>"
    },
    {
      "nonterminal": "<блок_try>",
      "rule": "'попытка' <тело> { 'перехват' <тип_исключения> 'как' <идентификатор> <тело> } [ 'наконец' <тело> ]"
    },
    {
      "nonterminal": "<возбуждение_исключения>",
      "rule": "'исключение' <тип_исключения> [ <строка_сообщения> ]"
    },
    {
      "nonterminal": "<блок_класса>",
      "rule": "'класс' <идентификатор> [ 'наследует' <идентификатор> ] <тело_класса>"
    },
    {
      "nonterminal": "<тело_класса>",
      "rule": "{ <поле_класса> | <метод_класса> }"
    },
    {
      "nonterminal": "<поле_класса>",
      "rule": "'поле' <идентификатор> <аннотация_типа>"
    },
    {
      "nonterminal": "<метод_класса>",
      "rule": "<объявление_функции>",
      "note": "Первый параметр неявно — 'я' (ссылка на экземпляр)"
    },
    {
      "nonterminal": "<объявление_типа>",
      "rule": "'тип' <идентификатор> <тело_типа>"
    },
    {
      "nonterminal": "<тело_типа>",
      "rule": "{ 'вариант' <идентификатор> [ { <поле_варианта> } ] }"
    },
    {
      "nonterminal": "<поле_варианта>",
      "rule": "<аннотация_типа>"
    },
    {
      "nonterminal": "<сопоставление>",
      "rule": "'сопоставить' <выражение> { <ветка_сопоставления> }"
    },
    {
      "nonterminal": "<ветка_сопоставления>",
      "rule": "<образец> 'вернуть' <выражение> | <образец> <тело>"
    },
    {
      "nonterminal": "<образец>",
      "rule": "<литерал> | <идентификатор> | <образец_варианта> | <образец_деструкции>"
    },
    {
      "nonterminal": "<импорт>",
      "rule": "'импорт' <идентификатор_модуля> | 'из' <идентификатор_модуля> 'импорт' { <идентификатор> }"
    },
    {
      "nonterminal": "<файловая_операция>",
      "rule": "<открытие_файла> | <чтение_файла> | <запись_файла> | <закрытие_файла> | <контекст_файла>"
    },
    {
      "nonterminal": "<открытие_файла>",
      "rule": "'открыть' <строка_пути> <режим_файла>"
    },
    {
      "nonterminal": "<режим_файла>",
      "rule": "'чтение' | 'запись' | 'добавление' | 'чтение_запись'"
    },
    {
      "nonterminal": "<контекст_файла>",
      "rule": "'с_файлом' <идентификатор> '=' <открытие_файла> <тело>"
    }
  ],
  "ast_nodes": {
    "Program": {
      "fields": ["self_import: SelfImport", "definitions: List[Definition]", "main_expression: Optional[Expression]"]
    },
    "SelfImport": {
      "fields": ["filename: String"]
    },
    "FunctionDefinition": {
      "fields": ["name: Identifier", "parameters: List[Parameter]", "body: Block", "return_type: Optional[TypeRef]"]
    },
    "Parameter": {
      "fields": ["name: Identifier", "type_annotation: Optional[TypeRef]", "default_value: Optional[Expression]"]
    },
    "Block": {
      "fields": ["statements: List[Statement]", "level: Integer"],
      "note": "level — уровень вложенности блока относительно родителя"
    },
    "IfExpression": {
      "fields": ["condition: Expression", "then_body: Block", "elif_branches: List[ElifBranch]", "else_body: Optional[Block]"]
    },
    "ElifBranch": {
      "fields": ["condition: Expression", "body: Block"]
    },
    "WhileLoop": {
      "fields": ["condition: Expression", "body: Block"]
    },
    "ForLoop": {
      "fields": ["variable: Identifier", "iterator: Expression", "body: Block"]
    },
    "LambdaExpression": {
      "fields": ["parameters: List[Parameter]", "body: Expression"]
    },
    "LetBinding": {
      "fields": ["name: Identifier", "type_annotation: Optional[TypeRef]", "value: Expression"]
    },
    "MatchExpression": {
      "fields": ["subject: Expression", "branches: List[MatchBranch]"]
    },
    "TryBlock": {
      "fields": ["body: Block", "handlers: List[ExceptHandler]", "finally_block: Optional[Block]"]
    },
    "ClassDefinition": {
      "fields": ["name: Identifier", "parent: Optional[Identifier]", "members: List[ClassMember]"]
    },
    "TypeDefinition": {
      "fields": ["name: Identifier", "variants: List[Variant]"]
    },
    "Variant": {
      "fields": ["name: Identifier", "fields: List[TypeRef]"]
    }
  },
  "error_codes": {
    "ОшибкаСамоИмпорта": "Нарушение правил самоимпорта файла",
    "ОшибкаВложенности": "Нарушение правил вложенности через '3' (пропуск уровня или некорректный переход)",
    "ОшибкаФорматирования": "Нарушение форматирования строки (несколько пробелов после '3', табуляция вместо пробела)",
    "ОшибкаСинтаксиса": "Общая синтаксическая ошибка",
    "ОшибкаНеизменности": "Попытка изменить неизменяемую связь 'пусть'",
    "ОшибкаТипа": "Несоответствие типов в операции",
    "ОшибкаДеления": "Деление на ноль",
    "ОшибкаИндекса": "Выход за границы последовательности",
    "ОшибкаКлюча": "Отсутствие ключа в словаре",
    "ОшибкаЗначения": "Неверное значение аргумента",
    "ОшибкаИмени": "Не найдено имя в области видимости",
    "ОшибкаАтрибута": "Отсутствие атрибута у объекта",
    "ОшибкаПереполнения": "Переполнение стека рекурсии",
    "ОшибкаФайла": "Ошибка файловой операции"
  },
  "examples_of_grammar_application": [
    {
      "description": "Минимальная программа",
      "code": "жёпка принадлежит привет.ж\nпечать \"Привет, мир!\"",
      "ast_summary": "Program { self_import: SelfImport('привет.ж'), definitions: [], main_expression: Print(String('Привет, мир!')) }"
    },
    {
      "description": "Функция с условием",
      "code": "жёпка принадлежит знак.ж\nфункция знак x\n3 если x > 0\n33 вернуть 1\n3 иначе_если x < 0\n33 вернуть -1\n3 иначе\n33 вернуть 0",
      "ast_summary": "Program с одной FunctionDefinition, содержащей IfExpression с тремя ветвями"
    },
    {
      "description": "Многоуровневая вложенность (4 уровня)",
      "code": "жёпка принадлежит обработка.ж\nфункция обработать данные\n3 для элемент в данные\n33 если элемент > 0\n333 печать элемент\n3333 вернуть элемент * 2",
      "ast_summary": "FunctionDefinition → ForLoop (level 1) → IfExpression (level 2) → Print (level 3) → Return (level 4)"
    }
  ],
  "metadata": {
    "author": "Z.ai",
    "license": "OFL (для спецификации); язык свободен для использования",
    "specification_status": "stable (версия 1.0.0)",
    "compatibility_note": "Грамматика обратно совместима с предыдущими версиями. Будущие версии могут добавлять новые продукции, но не изменять существующие."
  }
}
